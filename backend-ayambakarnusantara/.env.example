# ============================================================
# Template environment — backend Ayam Bakar Nusantara
# Salin ke .env.dev (developer) / .env.prod (produksi) dan isi nilai asli.
# File ini AMAN di-commit (tanpa rahasia).
# ============================================================

# === Server ===
PORT=5000
# development | production (menentukan file env yang dimuat)
NODE_ENV=development
# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# === Supabase ===
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=anon_key_publik
SUPABASE_SERVICE_ROLE_KEY=service_role_key_RAHASIA

# === Midtrans ===
MIDTRANS_SERVER_KEY=Mid-server-XXX
MIDTRANS_CLIENT_KEY=Mid-client-XXX
# false = sandbox, true = production
MIDTRANS_IS_PRODUCTION=false

# === Chatbot AI (OmniRoute — OpenAI-compatible) ===
OMNIROUTE_API_URL=https://omniroutelocal.zisaltech.site/v1/chat/completions
OMNIROUTE_API_KEY=sk-XXX
OMNIROUTE_MODEL=auto/best-free
