# === Template environment — Frontend Ayam Bakar Nusantara ===
# Konsisten dengan backend: .env (base/fallback) + .env.dev (developer) + .env.prod (produksi).
# - npm run dev   -> memuat .env base lalu .env.dev   (mode 'dev')
# - npm run build -> memuat .env base lalu .env.prod  (mode 'prod')
# Salin file ini ke .env.dev / .env.prod dan isi nilai asli.
# File ini AMAN di-commit (tanpa rahasia).

# Base URL backend (tanpa /api — backend mount langsung /auth, /product, dst)
VITE_API_BASE_URL=http://localhost:5000

# Google Maps API key (fitur lokasi di chat)
VITE_MAPS_API_KEY=

# === Supabase (client anon — publik, kontinjensi realtime/upload) ===
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=anon_key_publik
