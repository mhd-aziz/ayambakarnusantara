# File ini AMAN di-commit (tanpa rahasia).

# Base URL backend
VITE_API_BASE_URL=http://localhost:5000

# Google Maps API key (fitur lokasi di chat)
VITE_MAPS_API_KEY=

# === Supabase (client anon — publik) ===
REACT_APP_SUPABASE_URL=https://PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=anon_key_publik
